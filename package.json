{
  "name": "playwright-captcha-kraken-js",
  "version": "1.0.5",
  "description": "Playwright wrapper which uses CaptchaKraken-cli to solve captchas.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "CaptchaKraken-cli",
    "scripts"
  ],
  "scripts": {
    "build": "tsc",
    "test": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "postinstall": "node scripts/setup-python.js",
    "update-cli": "git -C CaptchaKraken-cli pull origin main"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JWriter20/PlaywrightCaptchaKrakenJS.git"
  },
  "keywords": [],
  "author": "",
