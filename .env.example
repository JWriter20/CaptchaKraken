# CaptchaKraken solver — environment.
# Copy to .env (or `source captchakraken.env` produced by install.sh).
#
# These are the ONLY two variables the solver needs.

# Where the solver sends inference requests.
#   Self-hosted: your local vLLM endpoint, e.g. http://localhost:8000/v1
#   Cloud API (coming soon): the hosted CaptchaKraken endpoint.
VLLM_BASE_URL=http://localhost:8000/v1

# Bearer token.
#   Self-hosted: whatever key you configured on your vLLM server.
#   Cloud API (coming soon): your CaptchaKraken account key.
CAPTCHA_KRAKEN_API_KEY=your-key-here
